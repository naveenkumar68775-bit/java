public class str {
    public static void main(String[] args) {
        String name="banana";
        HashMap<Character,Integer> map=new HashMap<>();
        for(char ch:name.toCharArray()){
            map.put(ch,map.getOrDefault(ch, 0)+1);
        }
        for(char c:map.keySet()){
            System.out.println(c+"="+map.get(c));
        }
    }
    
}
